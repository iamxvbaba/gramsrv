# ==============================================================================
# Telesrv Configuration Template (.env.example)
#
# Copy this file to .env and configure before starting:
#   cp .env.example .env
#
# Complete reference:
#   docs/configuration.en.md
#   docs/production.md
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Network Interface & Port Forwarding Configuration
# ------------------------------------------------------------------------------
# Public listening IP for client-facing edge ports (0.0.0.0 binds all interfaces)
TELESRV_LISTEN_IP=0.0.0.0

# Local listening IP for administrative and debugging ports (127.0.0.1 prevents public exposure)
TELESRV_LOCAL_LISTEN_IP=127.0.0.1

# Host Port Mappings (Host:Container)
TELESRV_EDGE_PORT=2398
TELESRV_PUBLIC_LINK_PORT=2401
TELESRV_BOT_API_PORT=8081
TELESRV_SFU_UDP_PORT=12399
TELESRV_UPDATE_PORT=2402
TELESRV_ADMIN_UI_PORT=2600
POSTGRES_PORT=5432
REDIS_PORT=6399

# Client advertise IP (must be reachable by clients; set your LAN or Public IP)
TELESRV_ADVERTISE_IP=127.0.0.1
TELESRV_ADVERTISE_PORT=2398

# MTProto Data Center ID & Default Country Code
TELESRV_DC=2
TELESRV_DEFAULT_COUNTRY_CODE=CN
TELESRV_STRICT_DC_CHECK=false

# ------------------------------------------------------------------------------
# 2. Database & Cache Credentials
# ------------------------------------------------------------------------------
POSTGRES_USER=telesrv
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=telesrv
TELESRV_POSTGRES_DSN=postgres://telesrv:${POSTGRES_PASSWORD}@postgres:5432/telesrv?sslmode=disable
TELESRV_POSTGRES_MAX_CONNS=50
TELESRV_POSTGRES_MIN_CONNS=16

TELESRV_REDIS_ADDR=redis:6379
TELESRV_REDIS_PASSWORD=
TELESRV_REDIS_DB=0

# ------------------------------------------------------------------------------
# 3. Inter-Service Security & Microservice Tokens
# (Generate with: openssl rand -hex 24)
# ------------------------------------------------------------------------------
TELESRV_CORE_EXEC_TOKEN=CHANGEME
TELESRV_FILE_TOKEN=CHANGEME
TELESRV_EGRESS_ACK_TOKEN=CHANGEME
TELESRV_GROUPCALL_CONTROL_TOKEN=CHANGEME
TELESRV_SFU_CONTROL_TOKEN=CHANGEME
TELESRV_ADMIN_API_TOKEN=CHANGEME

# Admin UI Login Password & Session Encryption Key
TELESRV_ADMIN_UI_PASSWORD=CHANGEME
TELESRV_ADMIN_UI_TOKEN=
TELESRV_ADMIN_SESSION_KEY=CHANGEME

# ------------------------------------------------------------------------------
# 4. Storage & Media Settings
# ------------------------------------------------------------------------------
TELESRV_BLOB_BACKEND=localfs
TELESRV_STORAGE_LOW_SPACE_GUARD_ENABLE=true
TELESRV_STORAGE_MIN_FREE_BYTES=1073741824
TELESRV_STORAGE_MAX_TOTAL_BYTES=0
TELESRV_STORAGE_USAGE_REFRESH_INTERVAL=1m
TELESRV_UPLOAD_PART_TTL=24h
TELESRV_UPLOAD_PART_GC_INTERVAL=30m
TELESRV_UPLOAD_PART_GC_BATCH=10000
TELESRV_EXTERNAL_MEDIA_ENABLE=true
TELESRV_WEBPAGE_PREVIEW_ENABLE=true

# ------------------------------------------------------------------------------
# 5. Outbox, Push, & Retention
# ------------------------------------------------------------------------------
TELESRV_OUTBOX_WORKERS=4
TELESRV_OUTBOX_BATCH=100
TELESRV_OUTBOX_LEASE_TIMEOUT=30s
TELESRV_OUTBOUND_PUSH_TIMEOUT=200ms
TELESRV_UPDATE_EVENT_RETENTION=168h
TELESRV_BOT_API_UPDATE_RETENTION=24h
TELESRV_ORPHAN_AUTH_KEY_RETENTION=24h
TELESRV_RETENTION_INTERVAL=1h
TELESRV_RETENTION_BATCH=10000

# ------------------------------------------------------------------------------
# 6. Public URLs & Branding
# ------------------------------------------------------------------------------
TELESRV_PUBLIC_BASE_URL=https://telesrv.net
TELESRV_PUBLIC_APP_SCHEME=telesrv
TELESRV_PUBLIC_WEB_BASE_URL=https://weba.telesrv.net
TELESRV_BRAND_PRODUCT_NAME=Telesrv
TELESRV_BRAND_PRODUCT_USERNAME=telesrv
TELESRV_BRAND_DESKTOP_APP_NAME=Telesrv Desktop
TELESRV_BRAND_ANDROID_APP_NAME=Telesrv Android
TELESRV_BRAND_IOS_APP_NAME=Telesrv iOS
TELESRV_BRAND_MACOS_APP_NAME=Telesrv macOS
TELESRV_BRAND_WEB_A_APP_NAME=Telesrv Web A
TELESRV_BRAND_WEB_K_APP_NAME=Telesrv Web K
TELESRV_BRAND_PREMIUM_NAME=Telesrv Premium
TELESRV_BRAND_STARS_NAME=Telesrv Stars

# ------------------------------------------------------------------------------
# 7. Edge & Connection Limits
# ------------------------------------------------------------------------------
TELESRV_WEBSOCKET_ENABLE=true
TELESRV_EDGE_LOCATION_TTL=90s
TELESRV_EDGE_LOCATION_HEARTBEAT_INTERVAL=30s
TELESRV_AUTH_KEY_CACHE_MAX_ENTRIES=262144
TELESRV_AUTH_KEY_CACHE_TTL=30m
TELESRV_TEMP_KEY_CACHE_MAX_ENTRIES=262144
TELESRV_TEMP_KEY_CACHE_TTL=30m
TELESRV_CORE_EXEC_GRPC_REQUEST_TIMEOUT=5s
TELESRV_FILE_GRPC_REQUEST_TIMEOUT=10s
TELESRV_EGRESS_ACK_GRPC_REQUEST_TIMEOUT=5s

# ------------------------------------------------------------------------------
# 8. Authentication & OTP
# ------------------------------------------------------------------------------
TELESRV_DEV_AUTH_CODE=
TELESRV_AUTH_CODE_TTL=5m
TELESRV_AUTH_CODE_MAX_ATTEMPTS=5
TELESRV_PHONE_CODE_DELIVERY_PROVIDER=development
TELESRV_PHONE_CODE_LENGTH=5
TELESRV_LOGIN_EMAIL_ENABLE=false

# ------------------------------------------------------------------------------
# 9. AI & Translation
# ------------------------------------------------------------------------------
TELESRV_AI_ENABLED=true
TELESRV_AI_PROVIDERS=local
TELESRV_TRANSLATION_ENABLED=false
TELESRV_BUSINESS_AI_PROVIDER=echo

# ------------------------------------------------------------------------------
# 10. Optional TON Blockchain Worker Settings
# ------------------------------------------------------------------------------
TELESRV_TON_NETWORK=testnet
TELESRV_TON_LITESERVER_ADDR=127.0.0.1:19949
TELESRV_TON_LITESERVER_PUBLIC_KEY=
TELESRV_TON_TRUSTED_BLOCK_SEQNO=
TELESRV_TON_TRUSTED_BLOCK_ROOT_HASH=
TELESRV_TON_TRUSTED_BLOCK_FILE_HASH=
TELESRV_TON_COLLECTION_ADDRESS=
TELESRV_TON_COLLECTION_CODE_HASH=
TELESRV_TON_INITIAL_ITEM_INDEX=0
TELESRV_TON_MNEMONIC_FILE=
TELESRV_TON_MINT_ENABLE=false

# ------------------------------------------------------------------------------
# 11. gRPC Service Endpoints & Inter-Service Communication
# (Docker Compose uses service names for internal DNS)
# ------------------------------------------------------------------------------
# File Service
TELESRV_FILE_GRPC_ADDR=0.0.0.0:2520
TELESRV_FILE_GRPC_TARGETS=file:2520

# Core Service
TELESRV_CORE_EXEC_GRPC_ADDR=0.0.0.0:2440
TELESRV_CORE_EXEC_GRPC_TARGETS=core:2440
TELESRV_CORE_EXEC_GRPC_REQUEST_TIMEOUT=5s

# Group Call Control (Core manages, SFU connects)
TELESRV_GROUPCALL_CONTROL_ADDR=0.0.0.0:2420
TELESRV_GROUPCALL_CONTROL_URL=http://core:2420

# Egress Service (ACK writeback)
TELESRV_EGRESS_ACK_GRPC_ADDR=0.0.0.0:2510
TELESRV_EGRESS_ACK_GRPC_TARGETS=egress:2510

# SFU Media Service
TELESRV_SFU_CONTROL_GRPC_ADDR=0.0.0.0:2450
TELESRV_SFU_CONTROL_GRPC_URL=grpc://sfu:2450
TELESRV_SFU_ADVERTISE_IP=
TELESRV_SFU_INSTANCE_TTL=90s
TELESRV_SFU_INSTANCE_HEARTBEAT_INTERVAL=30s
TELESRV_SFU_OWNER_TTL=2m
TELESRV_SFU_OWNER_HEARTBEAT_INTERVAL=30s

# Admin API (optional, on main core service)
TELESRV_ADMIN_API_ADDR=127.0.0.1:2601

# Debug/Profiling Endpoint
TELESRV_DEBUG_ADDR=127.0.0.1:6060

# Bot API HTTP Listener (optional)
TELESRV_BOT_API_ADDR=0.0.0.0:8081

# Public Landing Pages Web Server (optional, required for appeals/gifts)
TELESRV_PUBLIC_LINK_WEB_ADDR=

# ------------------------------------------------------------------------------
# 12. S3 / Object Storage (when TELESRV_BLOB_BACKEND=s3)
# ------------------------------------------------------------------------------
# TELESRV_S3_ENDPOINT=s3.amazonaws.com
# TELESRV_S3_REGION=us-east-1
# TELESRV_S3_BUCKET=telesrv-media
# TELESRV_S3_ACCESS_KEY_ID=
# TELESRV_S3_SECRET_ACCESS_KEY=
# TELESRV_S3_USE_SSL=true
# TELESRV_S3_PATH_STYLE=false
# TELESRV_S3_CREATE_BUCKET=false

# ------------------------------------------------------------------------------
# 13. Blob Storage Directories
# ------------------------------------------------------------------------------
TELESRV_BLOB_DIR=data/blobs
TELESRV_BLOB_STAGING_DIR=data/blob-staging

# Sticker/Reaction Seeds
TELESRV_STICKER_SEED_DIR=data/sticker-seed
TELESRV_STICKER_SEED_MAX_SETS=300

# Language Packs
TELESRV_LANGPACK_SEED_DIR=data/langpack

# Official Gifts
TELESRV_OFFICIAL_GIFTS_DIR=data/official-gifts

# GIF Directory
TELESRV_GIF_SEED_DIR=data/gifs

# Premium Promo Assets
TELESRV_PREMIUM_PROMO_SEED_DIR=data/premium-promo

# Map Tile Cache (Mapbox)
TELESRV_MAPTILE_CACHE_DIR=data/maptiles
TELESRV_MAPBOX_TOKEN=

# ------------------------------------------------------------------------------
# 14. External Media & Web Preview Limits
# ------------------------------------------------------------------------------
TELESRV_EXTERNAL_MEDIA_MAX_BYTES=10485760
TELESRV_EXTERNAL_MEDIA_RATE_PER_MIN=60
TELESRV_WEBPAGE_PREVIEW_MAX_BYTES=5242880
TELESRV_WEBPAGE_PREVIEW_RATE_PER_MIN=300
TELESRV_UPLOAD_INFLIGHT_MAX_BYTES=4194304000
TELESRV_UPLOAD_INFLIGHT_MAX_PARTS=8000
TELESRV_UPLOAD_INFLIGHT_MAX_FILES=64

# ------------------------------------------------------------------------------
# 15. OTP & Email Verification
# ------------------------------------------------------------------------------
TELESRV_LOGIN_EMAIL_CODE_LENGTH=6
TELESRV_LOGIN_EMAIL_REQUIRE_SETUP=false
TELESRV_EMAIL_CODE_DELIVERY_PROVIDER=smtp
TELESRV_OTP_WEBHOOK_URL=
TELESRV_OTP_WEBHOOK_SECRET=
TELESRV_OTP_WEBHOOK_TIMEOUT=5s

# SMTP Configuration (for email OTP/login email)
TELESRV_SMTP_HOST=
TELESRV_SMTP_PORT=587
TELESRV_SMTP_USERNAME=
TELESRV_SMTP_PASSWORD=
TELESRV_SMTP_FROM=
TELESRV_SMTP_FROM_NAME=
TELESRV_SMTP_TLS=starttls
TELESRV_SMTP_TIMEOUT=10s

# Phone Code Settings
TELESRV_AUTH_CODE_PHONE_RATE_LIMIT=5
TELESRV_AUTH_CODE_AUTH_KEY_RATE_LIMIT=20
TELESRV_AUTH_CODE_RATE_WINDOW=10m

# Rate Limiting
TELESRV_SEND_RATE_LIMIT=30
TELESRV_SEND_RATE_WINDOW=1m
TELESRV_CATCHUP_RATE_LIMIT=0
TELESRV_CATCHUP_RATE_WINDOW=1m

# ------------------------------------------------------------------------------
# 16. WebAuthn / Passkey Settings
# ------------------------------------------------------------------------------
TELESRV_PASSKEY_RP_ID=telesrv.net
TELESRV_PASSKEY_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 17. Telegram Login / OIDC (Optional)
# ------------------------------------------------------------------------------
TELESRV_TELEGRAM_LOGIN_ENABLE=false
TELESRV_TELEGRAM_LOGIN_ISSUER=
TELESRV_TELEGRAM_LOGIN_ALLOW_HTTP=false
TELESRV_TELEGRAM_LOGIN_SIGNING_KEYS_FILE=data/telegram-login/signing-keys.json
TELESRV_TELEGRAM_LOGIN_CODE_KEYS_FILE=data/telegram-login/code-keys.json
TELESRV_TELEGRAM_LOGIN_SECRET_PEPPER_FILE=data/telegram-login/client-secret-pepper
TELESRV_TELEGRAM_LOGIN_REQUEST_TTL=5m
TELESRV_TELEGRAM_LOGIN_CODE_TTL=2m
TELESRV_TELEGRAM_LOGIN_ID_TOKEN_TTL=1h
TELESRV_TELEGRAM_LOGIN_RETENTION=168h
TELESRV_TELEGRAM_LOGIN_SWEEP_INTERVAL=5m
TELESRV_TELEGRAM_LOGIN_SWEEP_BATCH=500

# ------------------------------------------------------------------------------
# 18. Calls, Group Calls, TURN & SFU
# ------------------------------------------------------------------------------
TELESRV_CALL_RING_TIMEOUT=90s
TELESRV_CALL_TOMBSTONE_TTL=60s
TELESRV_CALL_MAX_ACTIVE_PER_USER=4
TELESRV_CALL_REGISTRY_MAX_ENTRIES=10000
TELESRV_CALL_SIGNALING_MAX_BYTES=65536
TELESRV_CALL_SIGNALING_RATE=50
TELESRV_CALL_EXPIRY_INTERVAL=1s

# Group Call Settings
TELESRV_GROUPCALL_CHECK_TTL=45s
TELESRV_GROUPCALL_SWEEP_INTERVAL=10s
TELESRV_GROUPCALL_MAX_PARTICIPANTS=32

# TURN Relay
TELESRV_TURN_ENABLE=true
TELESRV_TURN_UDP_PORT=12400
TELESRV_TURN_ADVERTISE_IP=
TELESRV_TURN_SECRET=
TELESRV_TURN_RELAY_MIN_PORT=12500
TELESRV_TURN_RELAY_MAX_PORT=12999
TELESRV_CALL_TURN_CREDENTIAL_TTL=6h
TELESRV_CALL_FORCE_RELAY=false

# SFU Health & Load Balancing
TELESRV_SFU_INSTANCE_MAX_ACTIVE_CALLS=0
TELESRV_SFU_INSTANCE_HEALTH_TIMEOUT=1s
TELESRV_SFU_CONTROL_GRPC_REQUEST_TIMEOUT=5s

# ------------------------------------------------------------------------------
# 19. Livestream / RTMP (Optional)
# ------------------------------------------------------------------------------
TELESRV_LIVESTREAM_ENABLE=true
TELESRV_LIVESTREAM_RTMP_ADDR=0.0.0.0:2400
TELESRV_LIVESTREAM_RTMP_URL=
TELESRV_LIVESTREAM_FFMPEG_PATH=ffmpeg
TELESRV_LIVESTREAM_WORK_DIR=
TELESRV_LIVESTREAM_SEGMENT_KEEP=32

# ------------------------------------------------------------------------------
# 20. Premium & Stars
# ------------------------------------------------------------------------------
TELESRV_PREMIUM_BOT_USERNAME=premiumbot
TELESRV_PREMIUM_BOT_USER_ID=1250000015
TELESRV_PREMIUM_PLANS=3:90:750,6:180:1300,12:365:2400
TELESRV_PREMIUM_GRANT_MONTHS=3
TELESRV_PREMIUM_SWEEP_INTERVAL=1m
TELESRV_PREMIUM_SWEEP_BATCH=500
TELESRV_STARS_STARTING_GRANT=1000

# Star Gifts / Collectibles
TELESRV_COLLECTIBLE_USERNAME_URL_TEMPLATE=
TELESRV_RATING_ENABLED=true
TELESRV_RATING_PENDING_DELAY=24h
TELESRV_RATING_RECOMPUTE_INTERVAL=15m
TELESRV_RATING_RECOMPUTE_BATCH=500
TELESRV_RATING_STALE_AFTER=6h

# Rating Weights (permille/weights)
TELESRV_RATING_WEIGHT_STARS_RECEIVED_PERMILLE=1000
TELESRV_RATING_WEIGHT_STARS_SPENT_PERMILLE=250
TELESRV_RATING_WEIGHT_MESSAGE_SENT=1
TELESRV_RATING_WEIGHT_ACCOUNT_AGE_DAY=2
TELESRV_RATING_WEIGHT_GIFT_RECEIVED=25
TELESRV_RATING_WEIGHT_MODERATION_CASE=150
TELESRV_RATING_WEIGHT_SCAM_PENALTY=5000
TELESRV_RATING_WEIGHT_FAKE_PENALTY=5000
TELESRV_RATING_ACTIVITY_CAP=5000

# ------------------------------------------------------------------------------
# 21. Verification & Moderation
# ------------------------------------------------------------------------------
TELESRV_VERIFICATION_ENABLED=true
TELESRV_VERIFICATION_ALLOW_USER_TARGETS=false
TELESRV_VERIFICATION_REJECT_COOLDOWN=720h
TELESRV_VERIFICATION_APPLY_RATE_LIMIT=3
TELESRV_VERIFICATION_APPLY_RATE_WINDOW=24h
TELESRV_VERIFICATION_BOT_RATE_LIMIT=30
TELESRV_VERIFICATION_BOT_RATE_WINDOW=1m
TELESRV_VERIFICATION_NOTIFY_INTERVAL=15s
TELESRV_VERIFICATION_NOTIFY_BATCH=50
TELESRV_VERIFICATION_MAX_ACTIVE_PER_USER=3

# Bot Verification (Third-party badges)
TELESRV_BOT_VERIFICATION_ENABLED=true
TELESRV_BOT_VERIFICATION_MAX_PER_VERIFIER=10000
TELESRV_BOT_VERIFICATION_REQUEST_RATE_LIMIT=5
TELESRV_BOT_VERIFICATION_REQUEST_RATE_WINDOW=24h

# Broadcast System
TELESRV_BROADCAST_WORKER_INTERVAL=3s
TELESRV_BROADCAST_WORKER_LEASE=30s
TELESRV_BROADCAST_MATERIALIZE_BATCH=200
TELESRV_BROADCAST_DELIVERY_BATCH=50

# Channel Settings
TELESRV_CHANNEL_NUDGE_MAX_TARGETS=0
TELESRV_CHANNEL_ROW_CACHE_MAX=50000
TELESRV_CHANNEL_MEMBER_CACHE_MAX=100000
TELESRV_CHANNEL_DIALOG_CACHE_MAX=100000
TELESRV_CHANNEL_BOOST_CACHE_MAX=100000
TELESRV_CHANNEL_BOOST_CACHE_TTL=10s

# Outbox Poison (failed delivery diagnostics)
TELESRV_OUTBOX_POISON_RETENTION=1m
TELESRV_OUTBOX_POISON_CLEANUP_INTERVAL=15s

# Cache Settings
TELESRV_AUTH_USER_CACHE_TTL=1m

# Additional Admin Scoped Tokens
TELESRV_ADMIN_SCOPED_TOKENS=
TELESRV_ADMIN_UI_PERMISSIONS=*