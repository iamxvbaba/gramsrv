# Go build artifacts
/bin/
*.exe
# Root build output from `go build ./...` -- never a repo artifact.
/telesrv
/telesrv-admin
/telesrv-load
/telesrv-update
/gramsrv-backup
*.test
*.out
coverage.*
node_modules/

# Python caches
__pycache__/
*.py[cod]
*$py.class

# 本地环境 / 密钥（server RSA private key 必须持久化，但禁止入库）
.env
.env.*
!.env.example
*.local
*.pem
*.key
/secrets/
/data/*
!/data/langpack/
!/data/langpack/**
logs/
tmp/
.gocache/
.tdesktop-e2e/

# IDE
.idea/
.vscode/

# gramsrv-backup bundles: they contain .env, the server RSA key and the login
# signing keys. Never commit them.
/backup/
/backups/
/bundle/
*.tar.zst
*.sql.zst
*.rdb.zst

# Internal server deployment script (not part of the public repository)
/scripts/install.sh
