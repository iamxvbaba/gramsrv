# ==========================================
# Telegram Bot Configuration (required)
# ==========================================
BOT_TOKEN=
OWNER_IDS=
BOT_PUBLIC_USERNAME=
PRODUCT_NAME=Telesrv

# ==========================================
# gramsrv Admin API (required)
# The bot runs inside Docker, so an http://127.0.0.1:... loopback address would
# point at the container itself. Use the Docker host gateway (default bridge:
# 172.17.0.1) or switch to host network mode; gramsrv's Admin API must then
# listen on a non-loopback interface (TELESRV_ADMIN_API_ADDR=0.0.0.0:2399).
# ==========================================
GRAMSRV_API=http://172.17.0.1:2399
GRAMSRV_TOKEN=
GRAMSRV_ACTOR=grammystore
PUBLIC_BASE_URL=

# ==========================================
# Database Configuration (required)
# POSTGRES_* are used by docker-compose to create the database.
# The app assembles DATABASE_URL from these values, encoding passwords safely.
# Do NOT set DATABASE_URL in this file for Docker deployments.
# ==========================================
POSTGRES_USER=grammystore
POSTGRES_PASSWORD=
POSTGRES_DB=grammystore

# ==========================================
# Bot Mode (required)
# "random" = generate random numbers for users
# "real"   = users must bind their real Telegram phone number
# ==========================================
BOT_MODE=random

# ==========================================
# HTTP Server
# ==========================================
CODE_HTTP_HOST=0.0.0.0
CODE_HTTP_PORT=2800
CODE_WEBHOOK_SECRET=

# ==========================================
# Optional: Required Channel Gate
# ==========================================
REQUIRED_CHANNEL=
REQUIRED_CHANNEL_URL=

# ==========================================
# Optional: SOCKS5 Proxy for Telegram API
# Needed in regions where Telegram is blocked.
# Use socks5h:// for remote DNS resolution (recommended).
# ==========================================
TELEGRAM_PROXY_URL=
# TELEGRAM_PROXY_USERNAME=
# TELEGRAM_PROXY_PASSWORD=

# ==========================================
# Optional: Defaults
# ==========================================
DEFAULT_LANGUAGE=ru
DEFAULT_NUMBER_COUNTRY=RU
REFERRAL_BONUS=100
DAILY_BONUS=15
NOTIFICATION_TTL_DAYS=30
