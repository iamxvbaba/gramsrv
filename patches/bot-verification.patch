+	srv.handleCustomVerificationRequestsAPI(rec, httptest.NewRequest(
+		http.MethodGet, "/api/botverification/requests?status=pending&peer_type=channel&limit=10", nil))
+	if rec.Code != http.StatusServiceUnavailable {
