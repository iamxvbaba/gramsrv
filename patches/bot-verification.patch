+func TestVerifierBotSendVerificationDecisionCoversEveryOutcome(t *testing.T) {
+	cv := newFakeCustomVerification().activated()
+	svc, users, messages := newVerifierBotTestService(t, cv)
+	owner := newOwner(t, users, "+7212")
