+// RequestCounts is the queue summary by status.
+func (s *Service) RequestCounts(ctx context.Context) (map[domain.CustomVerificationRequestStatus]int64, error) {
+	st, err := s.readStore()
+	if err != nil {
+		return nil, err
+	}
+	return st.CustomVerificationRequestCounts(ctx)
+}
