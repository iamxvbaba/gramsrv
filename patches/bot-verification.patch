+                    <div className="entity-subtitle mono">{row.IconDocumentID}</div>
+                  </td>
+                  <td>{row.CanModifyCustomDescription ? t("common.yes") : t("common.no")}</td>
+                  <td>
+                    {row.Enabled
+                      ? <Badge tone="good">{t("botverification.enabled")}</Badge>
