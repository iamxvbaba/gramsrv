+		t.Fatalf("Icons while disabled = %+v / %v", icons, err)
+	}
+	if verifiers, err := h.svc.Verifiers(ctx, false, 0); err != nil || len(verifiers) != 1 {
+		t.Fatalf("Verifiers while disabled = %+v / %v", verifiers, err)
+	}
