+	}
+	if !target.Valid() || targetID <= 0 {
+		return domain.VerificationApplication{}, domain.ErrVerificationTargetInvalid
+	}
+	app, err := scanVerificationApplication(s.db.QueryRow(ctx, `
+SELECT `+verificationApplicationColumnList+`
