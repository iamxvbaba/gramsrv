+func (f *fakeStore) put(app domain.VerificationApplication) domain.VerificationApplication {
+	if app.ID == 0 {
+		f.nextID++
+		app.ID = f.nextID
+	}
+	if app.ID > f.nextID {
+		f.nextID = app.ID
+	}
+	if app.Version == 0 {
+		app.Version = 1
+	}
+	f.apps[app.ID] = app
+	return app
+}
