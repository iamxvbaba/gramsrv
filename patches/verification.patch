+)
+VALUES ('verifybot', 'verifybot', 'user', 1250000011, true, true, 0, now())
+ON CONFLICT (username_lower) DO UPDATE SET
+    username = EXCLUDED.username,
+    peer_type = EXCLUDED.peer_type,
+    peer_id = EXCLUDED.peer_id,
