+func TestFlexScalarsAcceptNumbersStringsAndBlanks(t *testing.T) {
+	var body mintCollectibleUsernameAPIRequest
+	req := httptest.NewRequest(http.MethodPost, "/api/actions/mint-collectible-username", strings.NewReader(`{
