+	if assetRec.Code != http.StatusNotFound ||
+		!strings.Contains(assetRec.Body.String(), `"code":"`+admin.CodeCollectibleNotFound+`"`) {
+		t.Fatalf("missing asset status=%d body=%s", assetRec.Code, assetRec.Body.String())
+	}
