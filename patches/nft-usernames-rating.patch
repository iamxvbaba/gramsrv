+	cases := []struct {
+		name string
+		req  MintCollectibleUsernameRequest
+		code string
+	}{
+		{
+			name: "short username",
+			req: MintCollectibleUsernameRequest{
+				CommandMeta: CommandMeta{CommandID: "bad-1", Actor: "ops", Reason: "invalid"},
+				Username:    "ab", Currency: domain.CollectibleCurrencyUSD, Amount: 1,
