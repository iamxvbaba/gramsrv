{{ define "tlprofile_route" }}
// Code generated by gotdgen, DO NOT EDIT.

package {{ $.Package }}

import (
    "github.com/iamxvbaba/td/bin"
    "github.com/iamxvbaba/td/tg"
)

{{ with .LayerRoute }}
type tlRouteMode uint8

const (
    tlRouteInvalid tlRouteMode = iota
    tlRouteDirect
    tlRouteRetag
    tlRouteRewrite
    tlRouteUnavailable
    tlRoutePolicy
    tlRouteProfileOnly
)

type tlRoute struct {
    semantic SemanticID
    mode tlRouteMode
    canonicalWireID uint32
}

func tlLookupRoute(profile Profile, wireID uint32) (tlRoute, bool) {
    switch wireID {
    {{- range .Wires }}
    case 0x{{ .Hex }}:
        switch profile {
        {{- range .Groups }}
        case {{ range $index, $layer := .Layers }}{{ if $index }}, {{ end }}Profile{{ $layer }}{{ end }}:
            return tlRoute{semantic: {{ .Semantic }}, mode: {{ .Mode }}, canonicalWireID: 0x{{ .CanonicalHex }}}, true
        {{- end }}
        default:
            return tlRoute{}, false
        }
    {{- end }}
    default:
        return tlRoute{}, false
    }
}

func tlNewCanonical(wireID uint32) (bin.Object, bool) {
    switch wireID {
    {{- range .Factories }}
    case 0x{{ .Hex }}:
        return &tg.{{ .GoType }}{}, true
    {{- end }}
    default:
        return nil, false
    }
}
{{ end }}
{{ end }}
